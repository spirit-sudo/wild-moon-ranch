---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-foreground text-background py-16 md:py-20 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-10 mb-16">
      <div>
        <div class="font-serif text-2xl tracking-wide mb-2">Salt & Sky</div>
        <p class="text-background/50 text-sm">Julian, California</p>
      </div>
      <div class="flex flex-wrap gap-x-8 gap-y-3 text-xs tracking-[0.15em] uppercase text-background/50">
        <a href={`${base}amenities`} class="hover:text-background transition-colors">Amenities</a>
        <a href={`${base}location`} class="hover:text-background transition-colors">Location</a>
        <a href={`${base}faq`} class="hover:text-background transition-colors">FAQ</a>
        <a href={`${base}book-direct`} class="hover:text-background transition-colors">Book Direct</a>
        <a href="https://www.instagram.com/saltandskylodgingco/" target="_blank" rel="noopener noreferrer" class="hover:text-background transition-colors">Instagram</a>
        <a href="mailto:saltandskylodgingco@gmail.com" class="hover:text-background transition-colors">Email</a>
        <a href="tel:6197984974" class="hover:text-background transition-colors">619.798.4974</a>
        <a href={`${base}#booking`} class="hover:text-background transition-colors">Book</a>
      </div>
    </div>
    <div class="text-center text-[11px] text-background/30 uppercase tracking-[0.3em]">
      &copy; {new Date().getFullYear()} Salt & Sky. All rights reserved.
    </div>
  </div>
</footer>
