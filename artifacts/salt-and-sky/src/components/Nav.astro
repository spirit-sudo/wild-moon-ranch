---
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}`, label: "Home" },
  { href: `${base}amenities`, label: "Amenities" },
  { href: `${base}location`, label: "Location" },
  { href: `${base}faq`, label: "FAQ" },
  { href: `${base}book-direct`, label: "Book Direct" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-12 py-5 flex justify-between items-center bg-background/80 backdrop-blur-md border-b border-border">
  <a href={base} class="font-serif text-xl tracking-wide">Salt & Sky</a>
  <div class="flex items-center gap-6">
    <div class="hidden md:flex items-center gap-6 text-sm tracking-wide text-muted-foreground">
      {links.slice(1).map((link) => (
        <a href={link.href} class="hover:text-foreground transition-colors">{link.label}</a>
      ))}
    </div>
    <a href={`${base}#booking`} class="text-sm px-5 py-2 border border-foreground/20 hover:bg-foreground hover:text-background transition-colors">
      Book Now
    </a>
  </div>
</nav>
