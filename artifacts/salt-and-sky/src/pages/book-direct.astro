---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

const base = import.meta.env.BASE_URL;

const perks = [
  "Save up to 18% by avoiding platform service fees",
  "Direct host contact from inquiry to checkout",
  "No hidden fees or surprise charges",
  "Priority rebooking for return guests",
];
---

<Layout
  title="Book Direct & Save 18% | Julian CA Cabin — No Airbnb Fees — Salt & Sky"
  description="Skip the Airbnb service fee. Book our Julian, CA cabin direct and save up to 18%, with direct host contact and no hidden charges."
>
  <Nav />

  <section class="pt-40 md:pt-48 pb-16 md:pb-20 px-6 md:px-12 max-w-4xl mx-auto text-center">
    <p class="text-muted-foreground tracking-[0.2em] uppercase text-xs mb-4">The smarter choice</p>
    <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl mb-8 leading-tight">Skip the platform. Keep the money.</h1>
    <p class="text-muted-foreground text-lg leading-relaxed max-w-2xl mx-auto">
      Booking directly means no Airbnb service fees, no VRBO markup, and no algorithmic pricing. You get the best rate, direct communication with us, and perks that don't exist on any listing platform.
    </p>
  </section>

  <section class="pb-28 md:pb-40 px-6 md:px-12 max-w-5xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 md:gap-24 items-start">
      <ul class="space-y-5">
        {perks.map((perk) => (
          <li class="flex items-start gap-4 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-foreground shrink-0 mt-0.5"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{perk}</span>
          </li>
        ))}
      </ul>

      <div class="bg-card border border-border p-8 md:p-12 rounded-sm">
        <h2 class="font-serif text-2xl mb-8 text-center">Cost Comparison</h2>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border text-muted-foreground">
              <th class="text-left font-normal py-3"></th>
              <th class="text-right font-normal py-3">Airbnb</th>
              <th class="text-right font-normal py-3">Book Direct</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border text-muted-foreground">
              <td class="py-4">Base rate (2 nights)</td>
              <td class="py-4 text-right font-medium">$850</td>
              <td class="py-4 text-right font-medium">$850</td>
            </tr>
            <tr class="border-b border-border text-muted-foreground">
              <td class="py-4">Cleaning fee</td>
              <td class="py-4 text-right font-medium">$150</td>
              <td class="py-4 text-right font-medium">$150</td>
            </tr>
            <tr class="border-b border-border text-muted-foreground">
              <td class="py-4">Service fee (15%)</td>
              <td class="py-4 text-right font-medium">$150</td>
              <td class="py-4 text-right font-medium">$0</td>
            </tr>
            <tr class="font-serif text-lg md:text-2xl text-foreground">
              <td class="pt-4">Your total</td>
              <td class="pt-4 text-right">$1,000</td>
              <td class="pt-4 text-right">$850</td>
            </tr>
          </tbody>
        </table>
        <div class="text-center text-sm text-muted-foreground mt-8">
          You keep $150 in your pocket by booking here instead of through a platform.
        </div>
      </div>
    </div>

    <div class="text-center mt-20 md:mt-24">
      <a href={`${base}#booking`} class="inline-block bg-foreground text-background hover:bg-foreground/80 transition-colors px-8 py-3.5 text-sm tracking-widest uppercase">
        Reserve Your Dates
      </a>
    </div>
  </section>

  <Footer />
</Layout>
