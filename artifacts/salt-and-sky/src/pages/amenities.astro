---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

const base = import.meta.env.BASE_URL;

const amenities = [
  {
    icon: "waves",
    title: "Cedar Soaking Tub",
    desc: "A hot tub carved from western red cedar, positioned at the property's edge with a full, unobstructed mountain panorama. This isn't a hotel jacuzzi bolted onto a deck — it's built into the hillside so you're soaking with the ridgeline directly in front of you, day or night. Best experienced after sunset, when Julian's certified Dark Sky status means you're looking up at the Milky Way while you soak.",
  },
  {
    icon: "dumbbell",
    title: "Pickleball Court",
    desc: "A full regulation court, on-property, with mountain views on every side. If you've only played pickleball in a converted parking lot or an indoor club, a volley at 5,440 feet changes the calculus — it's the rare vacation rental amenity that gets guests outside instead of onto the couch.",
  },
  {
    icon: "sun",
    title: "Sunset Deck",
    desc: "The deck runs the full width of the house, west-facing, with Adirondack chairs, bar-height seating, and a gas BBQ. Every seat on this deck faces the ridgeline — this is where most guests end up spending the majority of their stay, cocktail in hand, watching the light change on the mountains.",
  },
  {
    icon: "flame",
    title: "Indoor Fireplace",
    desc: "A wood-burning hearth, stocked with oak, for the colder months. Julian is one of the few Southern California destinations with genuine four-season weather — when there's a chill outside, this fireplace is the reason to stay in rather than a reason to be disappointed you left San Diego.",
  },
  {
    icon: "wifi",
    title: "Starlink WiFi",
    desc: "Rural-grade satellite internet running 100+ Mbps. If you need to take a call or finish something for work, you can — this isn't a \"no signal, sorry\" mountain cabin. If you don't need to work, it's fast enough to stream without a hiccup after the sun goes down.",
  },
  {
    icon: "mountain",
    title: "Dark Sky Views",
    desc: "Julian is a certified International Dark Sky Community — one of a small number in the country. Minimal light pollution means the Milky Way is visible to the naked eye on clear nights. Bring a tripod if you shoot photos; this is one of the few properties within an hour of San Diego where a night-sky shot is actually possible.",
  },
];
---

<Layout
  title="Cabin Amenities in Julian, CA | Cedar Hot Tub, Pickleball & Dark Skies — Salt & Sky"
  description="Private cedar soaking tub, regulation pickleball court, Starlink WiFi, and certified Dark Sky views — see every amenity at our Julian, CA mountain rental."
>
  <Nav />

  <section class="pt-40 md:pt-48 pb-16 md:pb-20 px-6 md:px-12 max-w-4xl mx-auto text-center">
    <p class="text-muted-foreground tracking-[0.2em] uppercase text-xs mb-4">Julian, California</p>
    <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl mb-8 leading-tight">Everything you need. Nothing you don't.</h1>
    <p class="text-muted-foreground text-lg leading-relaxed max-w-2xl mx-auto">
      At 5,440 feet in the Julian hills, we built this property around six things worth traveling for. No filler amenities, no "we also have a Keurig" padding — just the features guests actually plan their trip around.
    </p>
  </section>

  <section class="pb-28 md:pb-40 px-6 md:px-12 max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
      {amenities.map((item) => (
        <div>
          {item.icon === 'waves' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground mb-5"><path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg>}
          {item.icon === 'dumbbell' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground mb-5"><path d="M17.596 9h.404a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1.252a2 2 0 0 1-2-2v0H12v0a2 2 0 0 1-2 2H8.748a2 2 0 0 1-2-2v0H4v0a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h.404"/><path d="M21.166 8.81A2 2 0 0 0 22 7.5V5a2 2 0 0 0-2-2h-5a2 2 0 0 0-2 2v2.5a2 2 0 0 0 .834 1.81"/><path d="m2.84 15.19A2 2 0 0 0 2 16.5V19a2 2 0 0 0 2 2h5a2 2 0 0 0 2-2v-2.5a2 2 0 0 0-.834-1.81"/></svg>}
          {item.icon === 'sun' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground mb-5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>}
          {item.icon === 'flame' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground mb-5"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-2.258-2.55-2.857-2.55A2.5 2.5 0 0 0 7.5 11c0 1.5.5 2 1 3 .57 1.14 1.555 2.143 2 2.5"/><path d="M12.5 17.5a2.5 2.5 0 0 0 2.5-2.5c0-1.38-.5-2-1-3-1.072-2.143-2.258-2.55-2.857-2.55A2.5 2.5 0 0 0 11.5 14c0 1.5.5 2 1 3 .57 1.14 1.555 2.143 2 2.5"/><path d="M15 22H9c-1.5 0-2-1-2-2 0-1.5 1.5-2 2-2h6c1.5 0 2 1 2 2 0 1.5-1.5 2-2 2z"/></svg>}
          {item.icon === 'wifi' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground mb-5"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/></svg>}
          {item.icon === 'mountain' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground mb-5"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>}
          <h2 class="font-serif text-xl mb-3">{item.title}</h2>
          <p class="text-muted-foreground leading-relaxed text-sm">{item.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-20 md:mt-24">
      <a href={`${base}#booking`} class="inline-block bg-foreground text-background hover:bg-foreground/80 transition-colors px-8 py-3.5 text-sm tracking-widest uppercase">
        Reserve Your Dates
      </a>
    </div>
  </section>

  <Footer />
</Layout>
